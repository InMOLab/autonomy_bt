<?xml version="1.0" ?>
<root BTCPP_format="4">
  <BehaviorTree ID="main_tree">
    <ReactiveSequence>
      <LocalSensingNode/>
      <ReactiveFallback>
        <IsMissionCompleted/>
        <ReactiveSequence>
          <ReactiveFallback>
            <IsTaskNearby/>
            <ReactiveSequence>
              <IsTaskAssigned/>
              <MoveToTask/>
            </ReactiveSequence>
          </ReactiveFallback>
          <CompleteTask/>
        </ReactiveSequence>
      </ReactiveFallback>
    </ReactiveSequence>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="CompleteTask"/>
    <Action ID="LocalSensingNode"/>
    <Action ID="MoveToTask"/>
    <Condition ID="IsMissionCompleted" editable="true"/>
    <Condition ID="IsTaskAssigned" editable="true"/>
    <Condition ID="IsTaskNearby" editable="true"/>
  </TreeNodesModel>

</root>