<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="space-simulator">
    <Parallel failure_count="None"
              success_count="None">
      <GatherLocalInfo/>
      <ReactiveFallback>
        <ReactiveSequence>
          <IsConnectedWithLeader/>
          <ApplyCenTask/>
        </ReactiveSequence>
        <ReactiveFallback>
          <CommitToPlan/>
          <KeepPlanWhenIsolated source="own"/>
          <AssignTask/>
        </ReactiveFallback>
      </ReactiveFallback>
      <ReactiveSequence>
        <ReactiveFallback>
          <IsTaskAssigned/>
          <Halt/>
        </ReactiveFallback>
        <ReactiveFallback>
          <IsTaskCompleted/>
          <ReactiveSequence>
            <ReactiveFallback>
              <IsArrivedAtTarget/>
              <MoveToTarget/>
            </ReactiveFallback>
            <ExecuteTask/>
          </ReactiveSequence>
        </ReactiveFallback>
      </ReactiveSequence>
    </Parallel>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot)   Leader-as-solver ablation (2026-10-07, report 261007 §5.2): bt_follower_solver_grape.xml
  without ResetOnLeave (grace + commit, no reset), GRAPE follower; pair with bt_leader_solver.xml.
-->
  <TreeNodesModel>
    <Action ID="ApplyCenTask"
            editable="true"/>
    <Action ID="AssignTask"
            editable="true"/>
    <Action ID="ExecuteTask"
            editable="true"/>
    <Action ID="GatherLocalInfo"
            editable="true"/>
    <Action ID="Halt"
            editable="true"/>
    <Condition ID="IsArrivedAtTarget"
               editable="true"/>
    <Condition ID="IsConnectedWithLeader"
               editable="true"/>
    <Condition ID="IsTaskAssigned"
               editable="true"/>
    <Condition ID="IsTaskCompleted"
               editable="true"/>
    <Action ID="MoveToTarget"
            editable="true"/>
  </TreeNodesModel>

</root>
