<?xml version="1.0" encoding="UTF-8"?>
<!--
  Decentralised-only follower with message relay (CBBA / Hungarian): the dec branch of bt_archived/bt_follower_full_mesh_relay.xml without any leader plan. Used with bt_leader_relay.xml.
-->
<root BTCPP_format="4">
  <BehaviorTree ID="space-simulator">
    <Parallel failure_count="None"
              success_count="None">
      <GatherLocalInfo/>
      <ReactiveSequence>
        <UnpackRelayedMessages/>
        <AssignTask/>
        <RelayMessages scope="all" nested="1"/>
      </ReactiveSequence>
      <ReactiveSequence>
        <ReactiveFallback>
          <IsTaskAssigned/>
          <Halt/>
        </ReactiveFallback>
        <ReactiveFallback>
          <IsTaskCompleted/>
          <ReactiveSequence>
            <ReactiveFallback>
              <IsArrivedAtTarget/>
              <MoveToTarget/>
            </ReactiveFallback>
            <ExecuteTask/>
          </ReactiveSequence>
        </ReactiveFallback>
      </ReactiveSequence>
    </Parallel>
  </BehaviorTree>
</root>
