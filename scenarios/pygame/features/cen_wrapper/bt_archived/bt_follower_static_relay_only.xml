<?xml version="1.0" encoding="UTF-8"?>
<!--
  Follower BT — Static mode, ablation case (Relay ON, Forward OFF) (Exp 3).

  Both cen-followers AND dec-followers bridge fragmented dec clusters by
  packing dec-peer messages into `relayed_messages`. Cen-followers do NOT
  re-broadcast the leader's central_plan (Forward OFF). Out-of-range
  followers therefore see other dec peers via cen and dec-side bridges,
  but never learn about cen claims, so dec MRTA may still pick cen-claimed
  tasks.

  Compare against:
    bt_static/bt_follower_dec.xml             — Relay OFF, Forward OFF (baseline)
    bt_archived/bt_follower_static_forward_only.xml — Relay OFF, Forward ON
    bt_archived/bt_follower_static_full.xml        — Relay ON, Forward ON (full proposal)
-->
<root BTCPP_format="4">
  <BehaviorTree ID="space-simulator">
    <Parallel failure_count="None"
              success_count="None">
      <GatherLocalInfo/>
      <ReactiveFallback>
        <ReactiveSequence>
          <IsConnectedWithLeader/>
          <ApplyCenTask/>
          <RelayMessages scope="all" nested="1"/>
        </ReactiveSequence>
        <ReactiveSequence>
          <UnpackRelayedMessages/>
          <AssignTask/>
          <RelayMessages scope="all" nested="1"/>
        </ReactiveSequence>
      </ReactiveFallback>
      <Sequence>
        <IsTaskAssigned/>
        <Halt/>
      </Sequence>
    </Parallel>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="ApplyCenTask"
            editable="true"/>
    <Action ID="AssignTask"
            editable="true"/>
    <Action ID="GatherLocalInfo"
            editable="true"/>
    <Action ID="Halt"
            editable="true"/>
    <Action ID="RelayMessages"
            editable="true"/>
    <Action ID="UnpackRelayedMessages"
            editable="true"/>
    <Condition ID="IsConnectedWithLeader"
               editable="true"/>
    <Condition ID="IsTaskAssigned"
               editable="true"/>
  </TreeNodesModel>

</root>
