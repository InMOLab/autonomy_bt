<?xml version="1.0" encoding="UTF-8"?>
<!--
  Leader-as-proxy follower BT, variant "adopt+iso" (boundary-behaviour study, 2026-10-05): both changes of
  bt_ablation/bt_follower_proxy_no_iso.xml (proxy state handed to the plugin on leaving) and bt_ablation/bt_follower_proxy_no_adopt.xml (task of
  the last plan kept while isolated). Pair with a leader whose wrapper has export="merged" (bt_leader_proxy.xml).
  2026-10-08: iso keeps the follower's own last decision (source="own"), whether it came from the leader's plan or was
  made with the outside followers, as the relay's iso does (report 261007; until 10-07 the last plan's task, "plan").
  2026-10-08 (report 261007 "수정사항"; Fig. 2 skeleton): the disconnected branch is
  Seq([OnLeave], Fallback([Keep], Parallel([Ingest], [Filter], AssignTask, [EmitDec]))) — the chattering slots
  [OnLeave] and [Keep] above, the conflict slots around AssignTask below, all of the latter ticked every tick.
  iso keeps the follower's own last decision (KeepPlanWhenIsolated source="own") in every design.
-->
<root BTCPP_format="4">
  <BehaviorTree ID="space-simulator">
    <Parallel failure_count="None"
              success_count="None">
      <GatherLocalInfo/>
      <ReactiveFallback>
        <ReactiveSequence>
          <IsConnectedWithLeader/>
          <ApplyCenTask/>
          <EmitProxyMessage self_apply="1"/>
          <RelayMessages scope="outside"/>
        </ReactiveSequence>
        <ReactiveSequence>
          <AdoptProxyState/>
          <ReactiveFallback>
            <KeepPlanWhenIsolated source="own"/>
            <AssignTask/>
          </ReactiveFallback>
        </ReactiveSequence>
      </ReactiveFallback>
      <ReactiveSequence>
        <ReactiveFallback>
          <IsTaskAssigned/>
          <Halt/>
        </ReactiveFallback>
        <ReactiveFallback>
          <IsTaskCompleted/>
          <ReactiveSequence>
            <ReactiveFallback>
              <IsArrivedAtTarget/>
              <MoveToTarget/>
            </ReactiveFallback>
            <ExecuteTask/>
          </ReactiveSequence>
        </ReactiveFallback>
      </ReactiveSequence>
    </Parallel>
  </BehaviorTree>
</root>
