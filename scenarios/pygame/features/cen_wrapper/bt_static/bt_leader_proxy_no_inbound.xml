<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ablation variant (inbound=0, outbound=1) of bt_static/bt_leader_proxy.xml.
  Leader-as-proxy, leader BT. CentralisationWrapper runs the decentralised MRTA plugin (AssignTask)
  once per leader-connected follower, on a proxy of that follower, feeds the proxies the messages
  that connected followers relay from disconnected ones (inbound) and attaches the protocol
  messages of the boundary followers' proxies to the plan (outbound); TeachBT broadcasts the plan.
  See plugins/cen_wrapper/bt_nodes.py.
-->
<root BTCPP_format="4">
  <BehaviorTree ID="bt_leader">
    <Parallel failure_count="None"
              success_count="None">
      <GatherLocalInfo/>
      <CentralisationWrapper inbound="0" outbound="1">
        <AssignTask/>
      </CentralisationWrapper>
      <TeachBT/>
    </Parallel>
  </BehaviorTree>
</root>
